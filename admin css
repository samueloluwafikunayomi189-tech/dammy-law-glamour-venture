
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #080808;
  color: #fff;
  min-height: 100vh;
}

.admin-container {
  min-height: 100vh;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 25px;
  background:
    radial-gradient(circle at top, #30230d 0%, #080808 55%);
}

.login-card {
  width: 100%;
  max-width: 460px;
  padding: 45px 35px;
  background: #111;
  border: 1px solid #9b762d;
  border-radius: 18px;
  box-shadow: 0 15px 60px rgba(0,0,0,0.6);
}

.brand {
  text-align: center;
  margin-bottom: 45px;
}

.brand h1 {
  color: #d6ae57;
  font-family: Georgia, serif;
  font-size: 34px;
  letter-spacing: 5px;
}

.brand p {
  color: #aaa;
  font-size: 11px;
  letter-spacing: 4px;
  margin-top: 9px;
}

.login-heading {
  margin-bottom: 28px;
}

.login-heading h2 {
  font-family: Georgia, serif;
  font-size: 27px;
  color: #e4c477;
  margin-bottom: 10px;
}

.login-heading p {
  color: #aaa;
  font-size: 14px;
  line-height: 1.6;
}

form label {
  display: block;
  color: #ddd;
  font-size: 13px;
  margin: 20px 0 9px;
}

form input {
  width: 100%;
  padding: 16px;
  border: 1px solid #444;
  border-radius: 8px;
  background: #080808;
  color: white;
  font-size: 15px;
  outline: none;
}

form input:focus {
  border-color: #d6ae57;
}

form button {
  width: 100%;
  padding: 16px;
  margin-top: 28px;
  border: none;
  border-radius: 8px;
  background: linear-gradient(135deg, #e2c06d, #a77b28);
  color: #080808;
  font-weight: bold;
  font-size: 14px;
  letter-spacing: 2px;
  cursor: pointer;
}

form button:active {
  transform: scale(0.98);
}

#loginMessage {
  margin-top: 15px;
  font-size: 13px;
  text-align: center;
}

.security-note {
  text-align: center;
  color: #888;
  font-size: 12px;
  margin-top: 30px;
}

footer {
  text-align: center;
  color: #a88a4c;
  font-size: 11px;
  margin-top: 35px;
  letter-spacing: 1px;
}

@media (max-width: 480px) {
  .admin-container {
    padding: 16px;
  }

  .login-card {
    padding: 35px 23px;
  }

  .brand h1 {
    font-size: 28px;
  }
}


/* =====================================
   MONEY FORMAT
===================================== */

function money(amount) {
  return "₦" + amount.toLocaleString("en-NG");
}


/* =====================================
   PRODUCT CARD
===================================== */

function createProductCard(product) {
  return `
    <article class="product-card">

      <img
        class="product-image"
        src="${product.image}"
        alt="${product.name}"
        loading="lazy"
        onerror="this.onerror=null;this.src='https://placehold.co/600x800/f0ebe2/333333?text=Add+Product+Image'"
      >

      <div class="product-info">

        <span class="product-category">
          ${product.category.replace("-", " ")}
        </span>

        <h3>${product.name}</h3>

        <p class="product-description">
          ${product.description}
        </p>

        <p class="product-price">
          ${money(product.price)}
        </p>

        <button
          class="add-button"
          onclick="addToCart(${product.id})"
        >
          ADD TO BAG
        </button>

      </div>

    </article>
  `;
}


/* =====================================
   SEARCH AND FILTER
===================================== */

function matchesSearch(product, search) {
  return (
    product.name.toLowerCase().includes(search) ||
    product.description.toLowerCase().includes(search) ||
    product.category.toLowerCase().includes(search) ||
    product.tags.some(tag => tag.includes(search))
  );
}

function matchesCategory(product) {
  if (selectedCategory === "all") return true;

  if (selectedCategory === "women") {
    return product.tags.includes("women");
  }

  if (selectedCategory === "men") {
    return product.tags.includes("men") ||
      product.category === "men";
  }

  if (selectedCategory === "casual-office") {
    return ["casual", "office"].includes(product.category);
  }

  return (
    product.category === selectedCategory ||
    product.tags.includes(selectedCategory)
  );
}


/* =====================================
   SORT PRODUCTS
===================================== */

function sortProducts(list) {
  const sorted = [...list];

  if (sortSelect.value === "low") {
    sorted.sort((a, b) => a.price - b.price);
  }

  if (sortSelect.value === "high") {
    sorted.sort((a, b) => b.price - a.price);
  }

  if (sortSelect.value === "name") {
    sorted.sort((a, b) => a.name.localeCompare(b.name));
  }

  return sorted;
}


/* =====================================
   RENDER ALL DEPARTMENTS
===================================== */

function renderProducts() {
  const search = searchInput.value.toLowerCase().trim();

  let totalDisplayed = 0;

  departments.forEach(department => {
    const container = document.getElementById(department.id);

    if (!container) return;

    let filtered = products.filter(product => {
      return (
        department.matches(product) &&
        matchesCategory(product) &&
        matchesSearch(product, search)
      );
    });

    filtered = sortProducts(filtered);

    totalDisplayed += filtered.length;

    container.innerHTML = filtered
      .map(createProductCard)
      .join("");
  });

  const emptyMessage = document.getElementById("empty-message");

  if (emptyMessage) {
    emptyMessage.hidden = totalDisplayed !== 0;
  }
}


